# 腾讯云 AI 智能体配置模板
# 使用方法：复制此文件并重命名为 .env.local，然后填入您的实际密钥

# 1. 腾讯云 API 密钥 (从 https://console.cloud.tencent.com/cam/capi 获取)
VITE_TENCENT_SECRET_ID=您的_SECRET_ID
VITE_TENCENT_SECRET_KEY=您的_SECRET_KEY

# 2. 智能体应用 AppKey (从腾讯云 AI 智能体平台“调用信息”处获取)
VITE_TENCENT_APP_KEY=您的_APP_KEY

# 3. 智能体应用 ID (仅在 REST 轮询模式下用到)
VITE_APP_BIZ_ID=您的_APP_BIZ_ID

# 4. 服务地域 (如 ap-guangzhou, ap-shanghai)
VITE_TENCENT_REGION=ap-guangzhou

# 5. 可选配置
VITE_DEBUG=true
